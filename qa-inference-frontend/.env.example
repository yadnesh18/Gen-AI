# Leave blank to use Vite dev server proxy (recommended for local dev, routes to http://localhost:8080)
# Set to an explicit origin if connecting directly to a remote backend (e.g. http://localhost:8080)
VITE_API_BASE_URL=

# Groq API configuration
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL_NAME=openai/gpt-oss-20b
SERVER_PORT=8080
